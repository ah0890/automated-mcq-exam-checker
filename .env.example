# Copy to .env and adjust. .env is git-ignored.

# Leave unset to auto-generate a key stored in data/.secret_key
# DJANGO_SECRET_KEY=

DJANGO_DEBUG=false
# Set to true only when the application is served over HTTPS
DJANGO_HTTPS=false
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Where examinations, uploads, the database and backups are stored
# MCQ_DATA_DIR=D:/ExamData

# Full path to the Tesseract executable
TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe

MCQ_MAX_UPLOAD_MB=50
MCQ_TIME_ZONE=Asia/Karachi
